# Copy to .env for local use. On Render set these as Environment Variables.
# Never commit real values.

# --- UI gate (basic auth) ---
APP_USER=operator
APP_PASS=change-me-long-random

# --- Mandipay identities ---
API_USER=api-account@example.com
API_PASS=api-password
MERCHANT_USER=merchant-account@example.com
LOGIN_SALT=TEST_SALT

# --- merchant key table: {"MID":"SALT"} ---
KEYS_JSON={"00000000000000000000000000000000":"00000000000000000000000000000000"}
DEFAULT_MID=00000000000000000000000000000000

# --- Indian residential egress (city-pinned) ---
PROXY_URL=http://user:pass_country-in_city-gurgaon_session-abc_lifetime-168h@geo.iproyal.com:12321

# --- runtime ---
HOST=0.0.0.0
PORT=8777
LOG_PATH=/tmp/mandipay_ops/console_ops_98sd5.jsonl
